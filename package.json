{
  "name": "callmux",
  "version": "0.27.0",
  "description": "Multiplexer for MCP tool calls — parallel execution, batching, caching, and pipelining for any MCP server",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "callmux": "dist/bin/callmux.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist/",
    "assets/dashboard.html",
    "schema.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edimuj/callmux.git"
  },
  "homepage": "https://github.com/edimuj/callmux#readme",
  "bugs": {
    "url": "https://github.com/edimuj/callmux/issues"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build:dashboard": "npm --prefix dashboard ci --no-audit --no-fund && npm --prefix dashboard run build && node scripts/copy-dashboard-asset.mjs",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "test": "tsc --project tsconfig.test.json && node --test dist-test/*.test.js scripts/*.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:dashboard": "npm run build && npm run build:dashboard && playwright test",
    "prepack": "npm run build && npm run build:dashboard"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "multiplexer",
    "parallel",
    "batch",
    "proxy",
    "ai",
    "agents",
    "tool-calls"
  ],
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toon-format/toon": "^2.3.0",
    "undici": "^7.29.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "author": "Edin Mujkanovic",
  "license": "MIT"
}
